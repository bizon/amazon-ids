{
  "name": "@bizon/amazon-ids",
  "version": "6.0.0",
  "description": "Collection of Amazon identifiers",
  "repository": "https://github.com/bizon/amazon-ids",
  "author": "Bertrand Marron <bertrand.marron@gmail.com>",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "source": "./src/index.ts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "check:ts": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "devDependencies": {
    "@bizon/semantic-release-config": "^3.1.0",
    "@jest/globals": "^30.5.1",
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.3",
    "eslint-config-xo-bizon": "^4.5.0",
    "jest": "^30.5.1",
    "jest-junit": "^17.0.0",
    "semantic-release": "^25.0.8",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "xo": "^4.0.0"
  },
  "keywords": [
    "amazon",
    "sellercentral",
    "vendorcentral",
    "marketplaces"
  ],
  "release": {
    "extends": "@bizon/semantic-release-config"
  },
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d"
}
